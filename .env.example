# ==============================================================================
# IoBuild — Archivo Unificado de Variables de Entorno (.env)
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto para desarrollo o producción.
# Docker Compose leerá automáticamente este archivo para configurar todos los contenedores.
# NOTA: NUNCA subas tu '.env' real a git con claves secretas de producción.
# ==============================================================================

# ── 1. Base de Datos (MySQL) ──
# Contraseña de root para el contenedor MySQL (mysql-monolith)
DB_PASSWORD=iobuild

# ConnectionString de la base de datos para el Backend:
# - En Docker Compose (por defecto): apunta al contenedor mysql-monolith
# ConnectionStrings__IoBuild=Server=mysql-monolith;Port=3306;Database=iobuild;User=root;Password=iobuild
# - En Producción Cloud (ej. AWS RDS / Azure MySQL): descomenta y reemplaza:
# ConnectionStrings__IoBuild=Server=tu-db-cloud.rds.amazonaws.com;Port=3306;Database=iobuild;User=admin;Password=TuPasswordSeguro;

# ── 2. Backend & Seguridad ──
# Clave secreta para firmar los tokens JWT (MÍNIMO 32 caracteres)
JWT_SECRET=super-secure-jwt-secret-must-be-at-least-32-chars-long!

# Orígenes CORS permitidos (separados por coma, o '*' para desarrollo)
CORS_ALLOWED_ORIGINS=*

# ── 3. Pasarela de Pagos (Stripe) ──
# Clave pública de Stripe (utilizada tanto por el frontend como por el backend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Claves privadas del backend para procesamiento de checkout y webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_RESTRICTED_API_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── 4. Almacenamiento de Imágenes (Cloudinary) ──
# Configuración compartida entre frontend (upload widget) y backend
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset

# ── 5. Telemetría y MQTT (Mosquitto) ──
# Habilitado por defecto en la red interna de Docker
MQTT_HOST=mosquitto
MQTT_PORT=1883
