# IoBuild v2 — ejemplo para dev local
# Copiar a .env en la raiz (iobuild-v2/.env) — NO commitear el .env real
# En ASP.NET, "__" equivale a ":" (ej: Jwt__Secret = Jwt:Secret)

# ── Core (el compose ya trae defaults, esto es para override consciente) ──
DB_PASSWORD=iobuild
JWT_SECRET=iobuild-dev-secret-CAMBIAME-min-32-chars-1234567890

# Backend — override directo (lo que lee Program.cs)
ConnectionStrings__IoBuild=Server=localhost;Port=3306;Database=iobuild;User=root;Password=iobuild
# Cuando corres en compose, usa mysql-monolith:
# ConnectionStrings__IoBuild=Server=mysql-monolith;Port=3306;Database=iobuild;User=root;Password=iobuild
Jwt__Secret=${JWT_SECRET}
Migrations__ApplyOnStartup=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Stripe (pagos) — opcional, sin esto checkout/webhook no andan ──
Stripe__WebhookSecret=
Stripe__RestrictedApiKey=
Stripe__ProviderBaseUrl=https://api.stripe.com

# ── Cloudinary (fotos perfil/proyecto) — opcional ──
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__UploadBaseUrl=https://api.cloudinary.com

# ── InfluxDB (energia/status en vivo) — opcional, vacio = fallback graceful ──
Influx__Url=http://localhost:8086
Influx__Org=iobuild
Influx__Bucket=iobuild-telemetry
Influx__Token=iobuild-telemetry-token

# ── MQTT (telemetria) — dejalo en false salvo --profile telemetry ──
Mqtt__Enabled=false
Mqtt__Host=localhost
Mqtt__Port=1883

# ── Frontend (Vite) — para npm run dev ──
VITE_API_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:8080
VITE_APP_URL=http://localhost:5173
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_POLLING_INTERVAL_MS=30000
VITE_ANALYTICS_DEFAULT_MINUTES=10
